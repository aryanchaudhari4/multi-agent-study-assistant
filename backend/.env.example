# Gemini API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL - Choose one based on your deployment:
# 
# Local Development (SQLite):
# DATABASE_URL=sqlite:///./studyassistant.db
#
# Production on Vercel (PostgreSQL from Render, Railway, or Vercel Postgres):
# DATABASE_URL=postgresql://user:password@host:port/database_name
# Example from Render: postgresql://username:password@dpg-xxx.render.internal/dbname
#
DATABASE_URL=sqlite:///./studyassistant.db

# JWT Secret Key (CHANGE THIS IN PRODUCTION! Use a strong random string)
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_strong_secret_key_in_production

# CORS Origins (comma-separated list of frontend URLs)
# Add ALL URLs where your frontend is deployed
# Examples:
# - Local: http://localhost:5173,http://127.0.0.1:5173
# - Vercel Preview: https://your-app-preview.vercel.app
# - Vercel Production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000